---
interface Props {
  level?: 2 | 3;
  text: string;
  withDivider?: boolean;
  class?: string;
  id?: string;
}

const {
  level = 2,
  text,
  withDivider = false,
  class: extraClass = '',
  id,
} = Astro.props;

const Tag = level === 2 ? 'h2' : 'h3';
const baseClass =
  level === 2
    ? 'text-lg font-bold tracking-wide text-foreground'
    : 'text-base font-bold tracking-wide text-foreground';
---

<div class={extraClass}>
  <Tag id={id} class={baseClass}>{text}</Tag>
  {withDivider && <div class="mt-2 h-0.5 w-10 rounded-full bg-accent"></div>}
</div>

---
import ThemeToggle from './ThemeToggle.astro';
---

<header class="sticky top-0 z-40 bg-background/80 backdrop-blur-xl">
  <div class="mx-auto flex w-full max-w-3xl items-center justify-between px-4 py-3.5">
    <a
      href="/"
      class="text-[0.95rem] font-bold tracking-wide text-foreground transition-colors hover:text-accent"
    >
      @tonosaki
    </a>
    <ThemeToggle />
  </div>
  <div class="rainbow-line" aria-hidden="true"></div>
</header>

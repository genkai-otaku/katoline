---
import Layout from '../layouts/Layout.astro';
import ListPageLayout from '../components/ListPageLayout.astro';
import PlacesSection, {
  type Place,
} from '../components/PlacesSection.astro';

// 今期視聴アニメのリスト
// 例:
// { label: 'アニメタイトル', href: 'https://example.com' }
const thisSeasonAnimes: Place[] = [
  { label: 'ようこそ実力至上主義の教室へ ', href: '' },
  { label: '最強の王様、二度目の人生は何をする？', href: '' },
  { label: 'オタクに優しいギャルはいない!?', href: '' },
  { label: '愛してるゲームを終わらせたい', href: '' },
  { label: 'レプリカだって、恋をする。', href: '' },
  { label: 'クラスで2番目に可愛い女の子と友だちになった', href: '' },
  { label: 'お隣の天使様にいつの間にか駄目人間にされていた件2', href: '' },
  { label: '氷の城壁', href: '' },
  { label: '灰原くんの強くて青春ニューゲーム', href: '' },
  { label: '転生したらスライムだった件 第4期', href: '' },
  { label: 'Re:ゼロから始める異世界生活　4th season', href: '' },
  { label: '魔物喰らいの冒険者～俺だけ魔物を喰らって強くなる～', href: '' },
  { label: '杖と剣のウィストリア Season2', href: '' },
  { label: '悲劇の元凶となる最強外道ラスボス女王は民の為に尽くします。Season2', href: '' },
  { label: '最強の職業は勇者でも賢者でもなく鑑定士（仮）らしいですよ？', href: '' },
  { label: 'ポンコツ風紀委員とスカート丈が不適切なＪＫの話', href: '' },
  { label: '大賢者リドルの時間逆行', href: '' },
  { label: '逃がした魚は大きかったが釣りあげた魚が大きすぎた件', href: '' },
];
---

<Layout 
  title="今期視聴アニメ - @tonosaki"
  description="今期視聴しているアニメのメモです。タイトルをクリックすると各作品の公式サイトなどに飛べるようにしておきます。"
>
  <ListPageLayout
    title="今期視聴アニメ"
    backHref="/"
    backLabel="← ホームに戻る"
    description="今期視聴しているアニメのメモです。タイトルをクリックすると各作品の公式サイトなどに飛べるようにしておきます。"
  >
    <PlacesSection
      sectionId="this-season-anime-heading"
      title="今期視聴アニメ一覧"
      class="mt-10 mb-10"
      areas={
      [
        {
          id: '2026-winter-anime',
          title: '2026年冬アニメ',
          places: thisSeasonAnimes,
        },
      ]}
    />
  </ListPageLayout>
</Layout>



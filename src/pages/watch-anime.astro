---
import Layout from '../layouts/Layout.astro';
import ListPageLayout from '../components/ListPageLayout.astro';
import PlacesSection, {
  type Place,
} from '../components/PlacesSection.astro';

// 今期視聴アニメのリスト
// 例:
// { label: 'アニメタイトル', href: 'https://example.com' }
const thisSeasonAnimes: Place[] = [
  { label: 'ここは俺に任せて先に行けと言ってから10年がたったら伝説になっていた。 ', href: '' },
  { label: '捨てられ聖女の異世界ごはん旅 隠れスキルでキャンピングカーを召喚しました', href: '' },
  { label: '転校先の清楚可憐な美少女が、昔男子と思って一緒に遊んだ幼馴染だった件', href: '' },
  { label: 'きみが死ぬまで恋をしたい', href: '' },
  { label: '正反対な君と僕', href: '' },
  { label: '追放された転生重騎士はゲーム知識で無双する', href: '' },
  { label: '世界最強の後衛 ～迷宮国の新人探索者～', href: '' },
  { label: '', href: '' },
  { label: '', href: '' },
  { label: '転生したらスライムだった件 第4期', href: '' },
  { label: '', href: '' },
  { label: '', href: '' },
  { label: '黒猫と魔女の教室', href: '' },
  { label: '不死身な僕の日常　シーズン4', href: '' },
  { label: 'マリッジトキシン', href: '' },
  { label: '左ききのエレン', href: '' },
];
---

<Layout 
  title="今期視聴アニメ - @tonosaki"
  description="今期視聴しているアニメのメモです。タイトルをクリックすると各作品の公式サイトなどに飛べるようにしておきます。"
>
  <ListPageLayout
    title="今期視聴アニメ"
    backHref="/"
    backLabel="← ホームに戻る"
    description="今期視聴しているアニメのメモです。タイトルをクリックすると各作品の公式サイトなどに飛べるようにしておきます。"
  >
    <PlacesSection
      sectionId="this-season-anime-heading"
      title="今期視聴アニメ一覧"
      class="mt-10 mb-10"
      areas={
      [
        {
          id: '2026-winter-anime',
          title: '2026年春アニメ',
          places: thisSeasonAnimes,
        },
      ]}
    />
  </ListPageLayout>
</Layout>



---
import Layout from '../../layouts/Layout.astro';
import ListPageLayout from '../../components/ListPageLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

type BlogEntry = CollectionEntry<'blog'>;

export async function getStaticPaths() {
  const posts = await getCollection(
    'blog',
    (entry: BlogEntry) => !entry.data.draft,
  );

  return posts.map((post: BlogEntry) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props as { post: BlogEntry };
const { title, date } = post.data as {
  title: string;
  date?: string | Date;
};

const pageTitle = `${title} - @tonosaki`;

const { Content } = await post.render();
---

<Layout title={pageTitle} description={post.data.title}>
  <ListPageLayout
    title={title}
    backHref="/blog"
    backLabel="ブログ"
  >
    {date && (
      <p slot="meta" class="mt-2 text-sm text-muted">
        {new Date(date).toLocaleDateString('ja-JP')}
      </p>
    )}

    <article class="card prose max-w-none p-6 sm:p-8">
      <Content />
    </article>
  </ListPageLayout>
</Layout>

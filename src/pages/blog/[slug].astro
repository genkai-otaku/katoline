---
import Layout from '../../layouts/Layout.astro';
import ListPageLayout from '../../components/ListPageLayout.astro';
import Details from '../../components/mdx/Details.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

type BlogEntry = CollectionEntry<'blog'>;

export async function getStaticPaths() {
  const posts = await getCollection(
    'blog',
    (entry: BlogEntry) => !entry.data.draft,
  );

  return posts.map((post: BlogEntry) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: BlogEntry;
}

const { post } = Astro.props;
const { title, date } = post.data;
const pageTitle = `${title} - @tonosaki`;
const { Content } = await render(post);
---

<Layout title={pageTitle} description={title}>
  <ListPageLayout
    title={title}
    backHref="/blog"
    backLabel="ブログ"
  >
    {date && (
      <p slot="meta" class="mt-2 text-sm text-muted">
        {date.toLocaleDateString('ja-JP')}
      </p>
    )}

    <article class="card prose max-w-none p-6 sm:p-8">
      <Content components={{ Details }} />
    </article>
  </ListPageLayout>
</Layout>
